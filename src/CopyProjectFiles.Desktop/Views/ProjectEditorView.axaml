<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CopyProjectFiles.Desktop.ViewModels"
             x:Class="CopyProjectFiles.Desktop.Views.ProjectEditorView"
             x:DataType="vm:ProjectEditorViewModel">

  <ScrollViewer>
    <StackPanel Margin="28,24" Spacing="18" MaxWidth="860">

      <!-- ===== Header ===== -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" Text="{Binding HeaderSubtitle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Revert" Command="{Binding RevertCommand}" />
          <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>

      <Border Classes="status" Classes.error="{Binding StatusIsError}"
              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      </Border>

      <!-- ===== Details ===== -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="section" Text="Details" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Name" />
            <TextBox Text="{Binding Name}" Watermark="My project" />
            <TextBlock Classes="error" Text="{Binding NameError}"
                       IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Project folder (copy from)" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Grid.Column="0" Text="{Binding SourcePath}" Watermark="Folder containing your project" />
              <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseSourceCommand}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding SourceError}"
                       IsVisible="{Binding SourceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Destination folder (copy to)" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Grid.Column="0" Text="{Binding DestinationPath}" Watermark="Separate folder outside the project" />
              <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseDestinationCommand}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding DestinationError}"
                       IsVisible="{Binding DestinationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ===== Ignored files and folders: live checkbox tree of the project folder ===== -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="section" Text="Ignored files and folders" />
              <TextBlock Classes="muted" FontSize="12"
                         Text="Uncheck anything you don't want copied. Unchecking a folder skips everything inside it. Updates live as files change." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
              <Button Content="Expand" Command="{Binding ExpandAllCommand}" Padding="10,3" FontSize="12"
                      ToolTip.Tip="Open one more level of folders" />
              <Button Content="Collapse" Command="{Binding CollapseAllCommand}" Padding="10,3" FontSize="12" />
              <Button Content="Refresh" Command="{Binding RefreshTreeCommand}" Padding="10,3" FontSize="12" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="muted" FontSize="12" Text="{Binding TreeMessage}"
                     IsVisible="{Binding TreeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Border Classes="tree"
                  IsVisible="{Binding TreeMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}">
            <TreeView ItemsSource="{Binding Tree}" MaxHeight="440">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:FileNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="MinHeight" Value="28" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:FileNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              IsVisible="{Binding !IsPlaceholder}"
                              MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Classes.ignored="{Binding IsIgnored}"
                               Classes.folder="{Binding IsDirectory}" />
                    <TextBlock Text="{Binding SizeText}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>

          <TextBlock Classes="label" Text="{Binding IgnoredSummary}" />

          <ItemsControl ItemsSource="{Binding IgnoredPaths}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IgnoreEntryViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}"
                          Padding="10,3" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===== Copy ===== -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="Copy" />

          <StackPanel Spacing="4">
            <CheckBox IsChecked="{Binding KeepStructure}"
                      Content="Keep folder structure (off = flatten every file into one folder)" />
            <CheckBox IsChecked="{Binding ClearDestination}"
                      Content="Clear the destination folder before copying" />
          </StackPanel>

          <WrapPanel>
            <Button Classes="accent" Content="Copy files" Command="{Binding CopyCommand}" Margin="0,0,8,8" />
            <Button Content="Cancel" Command="{Binding CopyCancelCommand}"
                    IsVisible="{Binding IsCopying}" Margin="0,0,8,8" />
            <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,8,8" />
            <Button Content="Open destination folder" Command="{Binding OpenDestinationCommand}" Margin="0,0,8,8" />
          </WrapPanel>

          <TextBlock Classes="muted" FontSize="12" Text="{Binding CopyHint}"
                     IsVisible="{Binding CopyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap"
                     IsVisible="{Binding PreviewSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Spacing="4" IsVisible="{Binding IsCopying}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
